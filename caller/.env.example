# Copy to caller/.env. Never commit credentials or real call data.
DIAL_API_KEY=
DIAL_NUMBER=
# Use one model provider. auto prefers OpenAI when both keys are set.
EXTRACTION_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional alternative:
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Live calls require BOTH this flag and an explicit recipient allowlist.
LIVE_CALLS_ENABLED=false
DIAL_ALLOWED_NUMBERS=
MAX_CALLS_PER_RUN=3
MAX_CALLS_PER_NUMBER_PER_DAY=1
CALL_DURATION_SECONDS=180
CALL_TIMEOUT_SECONDS=420
TRANSCRIPT_GRACE_SECONDS=60
CALLER_TIMEZONE=America/Los_Angeles
CALLER_DATA_DIR=./data
# Required to start the HTTP service; keep this server-side in the Next.js app.
CALLER_API_TOKEN=
PORT=8787
HOST=127.0.0.1

FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt requirements-voice.txt ./
RUN pip install --no-cache-dir -r requirements-voice.txt
COPY househunt ./househunt
ENV DB_PATH=/data/househunt.db PORT=8080
EXPOSE 8080
CMD ["sh", "-c", "uvicorn househunt.voice.bridge:app --host 0.0.0.0 --port ${PORT} --no-access-log --ws-max-size 100000"]

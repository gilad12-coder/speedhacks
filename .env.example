# Postgres (Neon pooled connection string in production)
DATABASE_URL=postgres://localhost:5432/keyhunt

# Public base URL of the app, used for the Google OAuth redirect
APP_URL=http://localhost:3000

# 32+ random characters; signs session cookies and encrypts Google tokens
SESSION_SECRET=

# Google Cloud OAuth client (Web application), redirect URI: $APP_URL/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Shared secret the agent (Part 2) sends as "Authorization: Bearer <key>"
AGENT_API_KEY=

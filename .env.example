# Postgres (Neon pooled connection string in production)
DATABASE_URL=postgres://localhost:5432/keyhunt

# Public base URL of the app, used for the Google OAuth redirect
APP_URL=http://localhost:3000

# 32+ random characters; signs session cookies and encrypts Google tokens
SESSION_SECRET=

# Google Cloud OAuth client (Web application), redirect URI: $APP_URL/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Shared secret the agent (Part 2) sends as "Authorization: Bearer <key>"
AGENT_API_KEY=

# The Python app (househunt/): the agent worker and the main UI after onboarding.
# AGENT_WORKER_URL is for server-to-server calls; AGENT_APP_URL is where "Start search"
# sends housemates in the browser (defaults to AGENT_WORKER_URL).
AGENT_WORKER_URL=http://127.0.0.1:8788
AGENT_APP_URL=

# ---------------------------------------------------------------------------
# Python agent + main UI (househunt/). Run: uvicorn househunt.web.app:app --port 8000
# It reads these from .env; the Next.js app reads .env.local.
# ---------------------------------------------------------------------------

# The Python side reuses APP_URL (the onboarding app above) and AGENT_API_KEY to fetch
# briefs (/api/agent/briefs) and post results (/api/agent/runs).
# 1 = run that worker loop inside the web app; else run `python -m househunt.platform`.
RUN_PLATFORM_WORKER=1

# dry_run (fake calls) | approve (click "Call" per listing) | auto (call top N automatically)
CALL_MODE=dry_run
MAX_AUTO_CALLS=3
# 1 = canned listings (and never real dials); 0 = live discovery
MOCK_SOURCES=1
WEB_RESEARCH=1
SEARCH_MODEL=gpt-4.1
SEARCH_MAX_LISTINGS=10
SCREEN_TOP_N=5

# Dial: get a key with `dial auth login <email>`; it's saved in ~/.local/share/dial/auth.json
DIAL_API_KEY=
# Your Dial number (E.164) or its pn_… id
DIAL_FROM_NUMBER=
# Comma-separated US E.164 recipients explicitly approved for calling
DIAL_ALLOWED_NUMBERS=
CALL_DURATION_SECONDS=180
MAX_CALLS_PER_NUMBER_PER_DAY=1
CALLER_TIMEZONE=America/Los_Angeles
# Where to text results (your phone, E.164)
NOTIFY_NUMBER=
RENTER_NAME=

# OpenAI is preferred for transcript extraction; Anthropic is an optional alternative.
# Live extraction errors keep the transcript for retry; there is no heuristic fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Required when deployed: HTTP basic auth password (any username)
APP_PASSWORD=
DB_PATH=data/househunt.db

# Map pins: geocode addresses with OpenStreetMap Nominatim (results cached in SQLite)
GEOCODE=1

# Google sign-in (Calendar + Gmail alerts). Create a Web OAuth client in Google Cloud;
# redirect URI = <PUBLIC_BASE_URL>/auth/google/callback
# Set when deployed so the OAuth redirect uses https, e.g. https://househunt.onrender.com
PUBLIC_BASE_URL=

# Optional: Firecrawl (firecrawl.dev) reads pasted listing links from sites without a parser
FIRECRAWL_API_KEY=

# Passcode (4-6 digits) to hear your briefing when you call your KeyHunt number.
# Without it, the number only takes messages from landlords calling back.
BRIEFING_PIN=

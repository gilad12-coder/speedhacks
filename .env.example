# dry_run (fake calls) | approve (click "Call" per listing) | auto (call top N automatically)
CALL_MODE=dry_run
MAX_AUTO_CALLS=3
# 1 = canned listings (and never real dials); 0 = live scraping (Craigslist only so far)
MOCK_SOURCES=1

# Dial: get a key with `dial auth login <email>`; it's saved in ~/.local/share/dial/auth.json
DIAL_API_KEY=
# Your Dial number (E.164) or its pn_… id
DIAL_FROM_NUMBER=
# Where to text results (your phone, E.164)
NOTIFY_NUMBER=
RENTER_NAME=Lucy

# Claude is used to turn call transcripts into structured facts
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Required when deployed: HTTP basic auth password (any username)
APP_PASSWORD=
DB_PATH=data/househunt.db
